  "extra": {
    "package": "braces",
    "file": "lib/crave-depth-guard.js",
    "content": "'use strict';\n// Bound caller-supplied ASTs as well as parsed patterns; iterative, never recursive.\nmodule.exports = ast => {\n  const pending = [[ast, 0]];\n  let visited = 0;\n  while (pending.length) {\n    const [node, depth] = pending.pop();\n    if (++visited > 10000 || depth > 100) throw new SyntaxError('Brace AST exceeds safety limit');\n    if (node && Array.isArray(node.nodes)) {\n      if (node.nodes.length + pending.length > 10000) throw new SyntaxError('Brace AST exceeds safety limit');\n      for (const child of node.nodes) pending.push([child, depth + 1]);\n    }\n  }\n};\n",
    "after": "ba0ff5d638f893d0c0718cf79f922ccda6cbce511ec0564fb9e8782ae50700f9"
  }
