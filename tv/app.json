{
  "expo": {
    "name": "Crave Frame",
    "slug": "supper-scene-tv",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/brand/crave-frame-together-mark-v6.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.supperandscene.tv",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "allowBackup": false
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVBanner": "./assets/brand/crave-frame-together-banner-v6.png"
        }
      ],
      "./plugins/with-security.cjs"
    ],
    "experiments": {
      "baseUrl": "/tv"
    },
    "web": {
      "bundler": "metro",
      "name": "Crave Frame",
      "description": "Plan dinner and a movie with Crave Frame.",
      "favicon": "./assets/brand/crave-frame-together-mark-v6.png"
    }
  }
}
