    "@aws-sdk/client-lambda": "^3.1153.0",
    "@aws-sdk/rds-signer": "^3.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "aws-cdk": "^2.0.0",
    "aws-cdk-lib": "^2.200.0",
    "constructs": "^10.0.0",
    "esbuild": "^0.25.12",
    "@electric-sql/pglite": "^0.3.0"
  }
